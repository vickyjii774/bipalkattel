{
  "name": "bipalkattel-portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node backend/server.js",
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "build:watch": "npm run build:watch --prefix frontend",
    "start": "node backend/server.js",
    "seed": "node backend/seed.js",
    "admin:create": "node backend/create-admin.js",
    "check": "node --check backend/server.js && node --check backend/db.js && node --check backend/seed.js && node --check backend/create-admin.js && node --check backend/migrate-data.js",
    "test": "node --test backend/*.test.js",
    "data:migrate": "node backend/migrate-data.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.72.0",
    "multer": "^1.4.5-lts.1"
  }
}

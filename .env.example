# Required for production. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local defaults are backend/data and backend/uploads.
# On a host with a persistent disk, set these to its mounted directory.
DATA_DIR=
UPLOADS_DIR=

NODE_ENV=development
PORT=5000

# Used only by: npm run admin:create
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Bipal Kattel
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
